# Copy this to .env and run scripts/setup.sh to auto-populate secrets,
# or fill in manually. Keep .env out of version control.

# Timezone (e.g. America/New_York, America/Chicago, UTC)
TZ=UTC

# Default SNMP v1/v2c community (can add more communities in LibreNMS UI)
SNMP_COMMUNITY=public

# Poller thread count per dispatcher. Increase for large device counts.
# Rule of thumb: 1 thread per ~5-10 devices polled per minute.
# For 1000+ devices, consider distributed pollers instead.
POLLER_THREADS=24

# ── Database ──────────────────────────────────────────────────────────────
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# ── InfluxDB ──────────────────────────────────────────────────────────────
INFLUXDB_ORG=netcollector
INFLUXDB_ADMIN_PASSWORD=CHANGE_ME
# Long random string — used as the all-access API token.
# Must be the same value in LibreNMS influxdb.php config.
INFLUXDB_ADMIN_TOKEN=CHANGE_ME

# ── Oxidized ──────────────────────────────────────────────────────────────
# Pre-generated token inserted into LibreNMS DB by the librenms-init container.
OXIDIZED_API_TOKEN=CHANGE_ME

# ── Grafana ───────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
